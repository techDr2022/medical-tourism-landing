# Copy to .env.local and fill with real values. Never commit .env.local or real keys here.

# === Email (Resend) ===
# https://resend.com/api-keys
# For testing: use onboarding@resend.dev (no verification). For production: verify your domain at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM="Medical Travel <onboarding@resend.dev>"

# === Contact routing ===
# Where inquiries are sent
CONTACT_TO_EMAIL=info@techdr.in

# === Site URL (canonical domain for SEO, sitemap, OG tags) ===
NEXT_PUBLIC_SITE_URL=https://landing.medicaltoursindia.com

# === Search console verification (optional; omit if unused) ===
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-msvalidate-token

# === Display contact (shown in footer, confirmation emails) ===
NEXT_PUBLIC_CONTACT_EMAIL=info@techdr.in
NEXT_PUBLIC_WHATSAPP_NUMBER=916303225006

# === Nigeria Ads landing (/nigeria) — CRM webhook (TODO before ads launch) ===
# NEXT_PUBLIC_NIGERIA_LEAD_WEBHOOK_URL=https://hooks.example.com/nigeria-leads

# === Africa Ads landing (/africa) — enquiry emails use CONTACT_TO_EMAIL via Resend (/api/africa-contact) ===
# Optional CRM webhook (unused when email is the primary channel):
# NEXT_PUBLIC_AFRICA_LEAD_WEBHOOK_URL=https://hooks.example.com/africa-leads

# === Afghanistan Ads landing (/afghanistan) — CRM webhook (TODO before ads launch) ===
# NEXT_PUBLIC_AFGHANISTAN_LEAD_WEBHOOK_URL=https://hooks.example.com/afghanistan-leads

# === Google reCAPTCHA v3 ===
# https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
