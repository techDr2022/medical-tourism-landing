# Copy to .env.local and fill with real values. Never commit .env.local or real keys here.

# === Email (Resend) ===
# https://resend.com/api-keys
# For testing: use onboarding@resend.dev (no verification). For production: verify your domain at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM="Medical Travel <onboarding@resend.dev>"

# === Contact routing ===
# Where inquiries are sent
CONTACT_TO_EMAIL=info@techdr.in

# === Site URL (canonical domain for SEO, sitemap, OG tags) ===
NEXT_PUBLIC_SITE_URL=https://landing.medicaltoursindia.com

# === Display contact (shown in footer, confirmation emails) ===
NEXT_PUBLIC_CONTACT_EMAIL=info@techdr.in
NEXT_PUBLIC_WHATSAPP_NUMBER=918499005006

# === Google reCAPTCHA v3 ===
# https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
